




configuration {
    font: "SF Pro Text 12";
    lines: 10;
    fixed-num-lines: true;
    padding: 10px;
}

* {
    separatorcolor: transparent;
    text-color: #dcdcdc;
    background-color: #1e1e1e;
    border-color: #2a2a2a;
}

window {
    background-color: #1e1e1e;
    border: 1px;
    border-color: #2a2a2a;
    border-radius: 10px;
    width: 30%;
    padding: 0;
}

mainbox {
    border: 2px;
    border-color: #2a2a2a;
    border-radius: 10px;
    padding: 10px;
}

inputbar {
    children: [entry];
    padding: 8px;
}

entry {
    placeholder: "Search...";
    text-color: #dcdcdc;
    padding: 8px;
}

listview {
    lines: 10;
    scrollbar: true;
}

element {
    padding: 8px 10px;
    border-radius: 6px;
    children: [element-text, element-icon];
    background-color: transparent;
}

element-text {
    text-color: #dcdcdc;
}

element selected {
    background-color: #2f2f2f;
}

element selected element-text {
    text-color: #ffffff;
}

#scrollbar {
    handle-color: #3a3a3a;
    handle-width: 4px;
    padding: 0;
}

